{
  "name": "dhara",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "vitest run --project unit",
    "test:perm": "vitest run --project perm",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy && node --env-file-if-exists=.env scripts/db-roles.mjs && node --env-file-if-exists=.env scripts/load-courses.mjs",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "aws4fetch": "^1.0.20",
    "exceljs": "4.4.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "playwright-core": "1.63.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
