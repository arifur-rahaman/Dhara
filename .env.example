# Dhara environment variables. Copy to .env and fill in.
# Never commit real values. Only NEXT_PUBLIC_* values reach the browser.
# Variables marked (Mx) are required from that milestone; the app validates them at startup (src/server/env.ts).

# --- App ---------------------------------------------------------------
# Chamber app and admin portal origins (M1, M3). In production the admin portal must have its own host,
# e.g. https://admin.example.com. Left empty (or on the app's host), /admin works in development only.
APP_URL=http://localhost:3000
ADMIN_URL=
# Session signing secret, at least 32 random bytes (M1). Generate: openssl rand -base64 48
SESSION_SECRET=

# --- Database (M1) -----------------------------------------------------
# App role: not a superuser, not the table owner; RLS applies
DATABASE_URL=postgresql://dhara_app:dhara_app@localhost:5432/dhara
# (pnpm db:migrate creates dhara_app and dhara_admin and gives them these passwords)
# Admin-portal role: no grants on client tables (M3)
DATABASE_ADMIN_URL=postgresql://dhara_admin:dhara_admin@localhost:5432/dhara
# Reminder worker role (M5): owns the pg-boss schema; reads only counts, never chamber tables.
DATABASE_JOBS_URL=postgresql://dhara_jobs:dhara_jobs@localhost:5432/dhara
# Migration role (owns the tables), used only by migrations, seed, CI and deploy
DATABASE_MIGRATE_URL=postgresql://dhara:dhara@localhost:5432/dhara

# --- Field encryption (M2) ---------------------------------------------
# JSON map of key version -> base64 32-byte key. Generate a key: openssl rand -base64 32
FIELD_ENCRYPTION_KEYS={"v1":""}
# Key version used for new writes
FIELD_ENCRYPTION_ACTIVE=v1

# --- SMS (M1) ----------------------------------------------------------
# console = print to the server log in development; file = tests only
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
# Tests only (SMS_PROVIDER=file): file the end-to-end tests read login codes from
SMS_OUTBOX_FILE=
# Login codes allowed per IP address in 15 minutes (default 10). Raise only for automated tests.
OTP_LIMIT_PER_IP=10

# --- WhatsApp Business Platform (Stage 2, M7) --------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# --- Payments (Stage 2, M7) --------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- File storage, S3-compatible (M4) ----------------------------------
# File storage (M4). "local" keeps files in STORAGE_DIR (development and tests only; refused in production).
# "s3" uses any S3-compatible store (MinIO, AWS S3, Cloudflare R2). The bucket needs CORS allowing PUT and GET
# from APP_URL, because browsers upload and download directly with short-lived signed URLs.
STORAGE_PROVIDER=local
STORAGE_DIR=.storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dhara
S3_ACCESS_KEY=dhara
S3_SECRET_KEY=dhara-dev-secret

# --- Web Push (M5) -----------------------------------------------------
# Generate: pnpm dlx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- AI (Stage 2, M8) --------------------------------------------------
# Model names come from here, never from code
ANTHROPIC_API_KEY=
AI_MODEL_DRAFT=
AI_MODEL_EXTRACT=

# --- Admin portal (M3) -------------------------------------------------
# Comma-separated IPs or IPv4 CIDRs allowed to reach the admin portal. Required in production: empty means
# nobody gets in. The IP is read from X-Forwarded-For, so the reverse proxy in front of the app must set it.
# Admin accounts are created on the server: node --env-file=.env scripts/admin-create.mjs --phone ... --name ...
ADMIN_IP_ALLOWLIST=

# --- PDF (M4) ------------------------------------------------------------
# Path to a Chromium binary for receipt PDFs. Empty: Playwright's own Chromium is used if installed.
PDF_CHROMIUM_PATH=
# Origin Chromium uses to load the print pages, e.g. http://127.0.0.1:3000 inside the container. Empty: the request's origin.
PDF_RENDER_ORIGIN=

# --- Local Docker Compose only ------------------------------------------
POSTGRES_USER=dhara
POSTGRES_PASSWORD=dhara
POSTGRES_DB=dhara
MINIO_ROOT_USER=dhara
MINIO_ROOT_PASSWORD=dhara-dev-secret
