// Dhara database schema. plan.md section 6, TECH_GUIDE section 4.
// Tenant tables carry chamber_id and are protected by RLS (prisma/sql, applied by migrations).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  associate
  munshi
  staff
}

enum CaseScope {
  all
  assigned
}

enum MembershipStatus {
  active
  revoked
}

enum ActorKind {
  member
  admin
  system
}

/// People who sign in. Not a tenant table: one person can belong to several chambers.
model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  phone                 String    @unique // E.164, +8801XXXXXXXXX
  name                  String?
  passwordHash          String?   @map("password_hash")
  totpSecretEnc         String?   @map("totp_secret_enc")
  totpEnabledAt         DateTime? @map("totp_enabled_at") @db.Timestamptz
  totpLastStep          BigInt?   @map("totp_last_step")
  recoveryCodeHashes    String[]  @default([]) @map("recovery_code_hashes")
  privacyConsentAt      DateTime? @map("privacy_consent_at") @db.Timestamptz
  privacyConsentVersion String?   @map("privacy_consent_version")
  locale                String?
  theme                 String?
  numerals              String?
  /// F5: night and morning reminders, Asia/Dhaka wall-clock times as HH:MM.
  reminderNightOn       Boolean   @default(true) @map("reminder_night_on")
  reminderNightAt       String    @default("20:00") @map("reminder_night_at")
  reminderMorningOn     Boolean   @default(true) @map("reminder_morning_on")
  reminderMorningAt     String    @default("07:00") @map("reminder_morning_at")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships       Membership[]
  sessions          Session[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  @@map("users")
}

model Session {
  id              String    @id @default(uuid(7)) @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  userId          String    @map("user_id") @db.Uuid
  activeChamberId String?   @map("active_chamber_id") @db.Uuid
  mfaVerifiedAt   DateTime? @map("mfa_verified_at") @db.Timestamptz
  userAgent       String?   @map("user_agent")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Login codes. Only a hash of the code is stored.
model OtpChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  ipHash     String?   @map("ip_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([phone, createdAt])
  @@index([ipHash, createdAt])
  @@map("otp_challenges")
}

model Chamber {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String
  district    String
  plan        String    @default("trial")
  status      String    @default("active")
  trialEndsAt DateTime? @map("trial_ends_at") @db.Timestamptz
  /// Printed on receipts (ReceiptView design). Optional.
  address     String?
  /// Last receipt number issued; incremented inside the payment transaction (TECH_GUIDE section 14).
  receiptSeq  Int       @default(0) @map("receipt_seq")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships Membership[]
  invitations Invitation[]

  @@map("chambers")
}

model Membership {
  id         String           @id @default(uuid(7)) @db.Uuid
  chamberId  String           @map("chamber_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  role       Role
  caseScope  CaseScope        @default(assigned) @map("case_scope")
  canSeeFees Boolean          @default(false) @map("can_see_fees")
  status     MembershipStatus @default(active)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  chamber Chamber @relation(fields: [chamberId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chamberId, userId])
  @@index([chamberId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  chamberId  String    @map("chamber_id") @db.Uuid
  phone      String
  name       String
  role       Role
  caseScope  CaseScope @default(assigned) @map("case_scope")
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  chamber Chamber @relation(fields: [chamberId], references: [id], onDelete: Cascade)

  @@index([chamberId])
  @@map("invitations")
}

/// Append-only. The app role may insert and select, never update or delete.
model AuditLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  chamberId   String?   @map("chamber_id") @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorKind   ActorKind @map("actor_kind")
  action      String
  entity      String
  entityId    String?   @map("entity_id")
  fields      Json?
  ipHash      String?   @map("ip_hash")
  at          DateTime  @default(now()) @db.Timestamptz

  @@index([chamberId, at])
  @@map("audit_log")
}

/// Failed password and two-step attempts, for rate limiting. Keys are keyed hashes, never raw phones or IPs.
model AuthAttempt {
  id        String   @id @default(uuid(7)) @db.Uuid
  keyHash   String   @map("key_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([keyHash, createdAt])
  @@map("auth_attempts")
}

enum CourtLevel {
  supreme
  district
  tribunal
}

enum CaseType {
  civil
  criminal_cr
  criminal_gr
  writ
  family
  money_loan
  other
}

enum OurSide {
  plaintiff
  defendant
}

enum CaseStatus {
  active
  disposed
}

enum HearingSource {
  manual
  photo_ai
  court_sync
}

/// Court directory (F2). Rows without chamber_id are the shared directory (seeded by migration);
/// a chamber can add its own courts. Official names stay exactly as written in court records.
model Court {
  id          String     @id @default(uuid(7)) @db.Uuid
  chamberId   String?    @map("chamber_id") @db.Uuid
  nameBn      String     @map("name_bn")
  nameEn      String     @map("name_en")
  level       CourtLevel
  district    String?
  officialUrl String?    @map("official_url")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  cases Case[]

  @@index([district])
  @@index([chamberId])
  @@map("courts")
}

/// Client name only (P2). Contact details live in client_contacts (P1, owner-only, encrypted).
model Client {
  id          String    @id @default(uuid(7)) @db.Uuid
  chamberId   String    @map("chamber_id") @db.Uuid
  displayName String    @map("display_name")
  createdBy   String    @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  contact          ClientContact?
  contactInChamber ClientContact[] @relation("ContactClientChamber")
  payments         Payment[]       @relation("PaymentClientChamber")
  cases            Case[]
  casesInChamber   Case[]          @relation("CaseClientChamber")

  @@unique([id, chamberId], map: "clients_id_chamber_idx")
  @@index([chamberId])
  @@map("clients")
}

/// Owner-only (P1). Every value is AES-256-GCM encrypted by the app; RLS also requires the owner role.
model ClientContact {
  clientId   String    @id @map("client_id") @db.Uuid
  chamberId  String    @map("chamber_id") @db.Uuid
  phoneEnc   String?   @map("phone_enc")
  emailEnc   String?   @map("email_enc")
  nidEnc     String?   @map("nid_enc")
  addressEnc String?   @map("address_enc")
  consentAt  DateTime? @map("consent_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  client          Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Contact and client must belong to the same chamber.
  clientInChamber Client @relation("ContactClientChamber", fields: [clientId, chamberId], references: [id, chamberId], map: "client_contacts_client_chamber_fkey")

  @@index([chamberId])
  @@map("client_contacts")
}

model Case {
  id                   String     @id @default(uuid(7)) @db.Uuid
  chamberId            String     @map("chamber_id") @db.Uuid
  type                 CaseType
  number               String
  year                 String
  courtId              String     @map("court_id") @db.Uuid
  courtNo              String?    @map("court_no")
  ourSide              OurSide    @map("our_side")
  clientId             String?    @map("client_id") @db.Uuid
  partiesText          String?    @map("parties_text")
  opposingCounsel      String?    @map("opposing_counsel")
  note                 String?
  assigneeMembershipId String?    @map("assignee_membership_id") @db.Uuid
  status               CaseStatus @default(active)
  createdBy            String     @map("created_by") @db.Uuid
  deletedAt            DateTime?  @map("deleted_at") @db.Timestamptz
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  court             Court      @relation(fields: [courtId], references: [id])
  client            Client?    @relation(fields: [clientId], references: [id])
  // Client must belong to the same chamber as the case.
  clientInChamber   Client?    @relation("CaseClientChamber", fields: [clientId, chamberId], references: [id, chamberId], map: "cases_client_chamber_fkey")
  hearings          Hearing[]
  hearingsInChamber Hearing[]  @relation("HearingCaseChamber")
  documents         Document[] @relation("DocumentCaseChamber")
  fees              Fee[]      @relation("FeeCaseChamber")
  payments          Payment[]  @relation("PaymentCaseChamber")

  @@unique([id, chamberId], map: "cases_id_chamber_idx")
  @@index([chamberId])
  @@index([chamberId, assigneeMembershipId])
  @@map("cases")
}

/// One court date of a case. outcome_note records what happened that day (the timeline).
model Hearing {
  id           String        @id @default(uuid(7)) @db.Uuid
  chamberId    String        @map("chamber_id") @db.Uuid
  caseId       String        @map("case_id") @db.Uuid
  date         DateTime      @db.Date
  serialOrItem String?       @map("serial_or_item")
  purpose      String?
  outcomeNote  String?       @map("outcome_note")
  /// User who recorded what happened (may differ from who added the date).
  outcomeBy    String?       @map("outcome_by") @db.Uuid
  source       HearingSource @default(manual)
  addedBy      String        @map("added_by") @db.Uuid
  sourceUrl    String?       @map("source_url")
  fetchedAt    DateTime?     @map("fetched_at") @db.Timestamptz
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  case          Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  // Hearing must belong to a case of the same chamber.
  caseInChamber Case @relation("HearingCaseChamber", fields: [caseId, chamberId], references: [id, chamberId], map: "hearings_case_chamber_fkey")

  @@index([chamberId, date])
  @@index([caseId, date])
  @@map("hearings")
}

/// P11: owner assigns and sees all; everyone else sees and completes their own.
model Task {
  id                   String    @id @default(uuid(7)) @db.Uuid
  chamberId            String    @map("chamber_id") @db.Uuid
  assigneeMembershipId String    @map("assignee_membership_id") @db.Uuid
  caseId               String?   @map("case_id") @db.Uuid
  title                String
  dueOn                DateTime? @map("due_on") @db.Date
  doneAt               DateTime? @map("done_at") @db.Timestamptz
  createdBy            String    @map("created_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([chamberId, assigneeMembershipId])
  @@map("tasks")
}

enum AdminRole {
  super_admin
  support
}

/// Platform staff (plan.md 3.2). A separate identity from chamber users; used only by the admin portal.
model PlatformAdmin {
  id            String    @id @default(uuid(7)) @db.Uuid
  phone         String    @unique
  name          String
  role          AdminRole
  passwordHash  String    @map("password_hash")
  totpSecretEnc String    @map("totp_secret_enc")
  totpLastStep  BigInt?   @map("totp_last_step")
  disabledAt    DateTime? @map("disabled_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions AdminSession[]

  @@map("platform_admins")
}

model AdminSession {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  adminId   String    @map("admin_id") @db.Uuid
  ipHash    String?   @map("ip_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

/// Every admin action. Append-only for the admin role; the chamber app cannot read it.
model AdminAuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  adminId   String?  @map("admin_id") @db.Uuid
  action    String
  chamberId String?  @map("chamber_id") @db.Uuid
  entity    String
  entityId  String?  @map("entity_id")
  fields    Json?
  ipHash    String?  @map("ip_hash")
  at        DateTime @default(now()) @db.Timestamptz

  @@index([at])
  @@map("admin_audit_log")
}

/// Support access (plan.md 3.2): admin asks with a reason → owner approves → valid 24 hours, revocable.
model SupportGrant {
  id          String    @id @default(uuid(7)) @db.Uuid
  chamberId   String    @map("chamber_id") @db.Uuid
  adminId     String    @map("admin_id") @db.Uuid
  reason      String
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  approvedBy  String?   @map("approved_by") @db.Uuid
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz
  rejectedAt  DateTime? @map("rejected_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz

  @@index([chamberId])
  @@map("support_grants")
}

/// Subscription payments recorded by hand in the admin portal (M3); gateway payments come later.
model SubscriptionPayment {
  id           String   @id @default(uuid(7)) @db.Uuid
  chamberId    String   @map("chamber_id") @db.Uuid
  amountPoisha Int      @map("amount_poisha")
  method       String
  reference    String?
  paidOn       DateTime @map("paid_on") @db.Date
  recordedBy   String   @map("recorded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([chamberId])
  @@map("subscription_payments")
}

enum DocumentKind {
  order
  pleading
  other
}

enum DocumentStatus {
  /// Upload URL issued; not visible until the file is checked.
  pending
  ready
}

/// Case documents (F14). Files live in object storage; P5/P6 are enforced by RLS from the caller's membership.
model Document {
  id           String         @id @default(uuid(7)) @db.Uuid
  chamberId    String         @map("chamber_id") @db.Uuid
  caseId       String         @map("case_id") @db.Uuid
  kind         DocumentKind
  title        String
  /// Original file name, kept only in the database (never in the storage key).
  fileName     String         @map("file_name")
  contentType  String         @map("content_type")
  sizeBytes    Int            @map("size_bytes")
  storageKey   String         @unique @map("storage_key")
  /// F15 / P6: visible to the uploader and the owner only.
  confidential Boolean        @default(false)
  status       DocumentStatus @default(pending)
  uploadedBy   String         @map("uploaded_by") @db.Uuid
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  caseInChamber Case @relation("DocumentCaseChamber", fields: [caseId, chamberId], references: [id, chamberId], onDelete: Restrict, map: "documents_case_chamber_fkey")

  @@index([chamberId, caseId])
  @@map("documents")
}

/// A fee charged on a case (F9), e.g. "Hearing fee". Dues = fees − payments.
model Fee {
  id           String    @id @default(uuid(7)) @db.Uuid
  chamberId    String    @map("chamber_id") @db.Uuid
  caseId       String    @map("case_id") @db.Uuid
  description  String
  /// Integer poisha (1 taka = 100 poisha).
  amountPoisha Int       @map("amount_poisha")
  chargedOn    DateTime  @map("charged_on") @db.Date
  createdBy    String    @map("created_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  caseInChamber Case @relation("FeeCaseChamber", fields: [caseId, chamberId], references: [id, chamberId], onDelete: Restrict, map: "fees_case_chamber_fkey")

  @@index([chamberId, caseId])
  @@map("fees")
}

enum PaymentMethod {
  cash
  bkash
  nagad
  bank
  /// Stage 2 payment links (F31); not offered in Stage 1.
  gateway
}

/// Money received (F9, F11), with a receipt number unique per chamber (F10).
model Payment {
  id           String        @id @default(uuid(7)) @db.Uuid
  chamberId    String        @map("chamber_id") @db.Uuid
  caseId       String        @map("case_id") @db.Uuid
  clientId     String?       @map("client_id") @db.Uuid
  amountPoisha Int           @map("amount_poisha")
  method       PaymentMethod
  /// bKash/Nagad transaction ID or bank reference (F11).
  reference    String?
  /// "Hearing fee" and similar, printed on the receipt.
  description  String
  paidOn       DateTime      @map("paid_on") @db.Date
  receiptNo    Int           @map("receipt_no")
  receivedBy   String        @map("received_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  caseInChamber   Case    @relation("PaymentCaseChamber", fields: [caseId, chamberId], references: [id, chamberId], onDelete: Restrict, map: "payments_case_chamber_fkey")
  clientInChamber Client? @relation("PaymentClientChamber", fields: [clientId, chamberId], references: [id, chamberId], onDelete: Restrict, map: "payments_client_chamber_fkey")

  @@unique([chamberId, receiptNo])
  @@index([chamberId, paidOn])
  @@index([chamberId, caseId])
  @@map("payments")
}

/// Web Push endpoints of one person's devices (F5). Readable by the person and by the jobs role only.
model PushSubscription {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// In-app notification centre (Notifications design). payload holds ids and numbers, never client contact.
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  chamberId String?   @map("chamber_id") @db.Uuid
  kind      String
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// One reminder per person, kind and Dhaka date, so a repeated job tick never sends twice.
model ReminderLog {
  userId    String   @map("user_id") @db.Uuid
  kind      String
  localDate DateTime @map("local_date") @db.Date
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz

  @@id([userId, kind, localDate])
  @@map("reminder_log")
}

/// Offline outbox (F21): each queued write has a client-made key; a repeat of the same key is ignored.
model SyncReceipt {
  key       String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  chamberId String   @map("chamber_id") @db.Uuid
  kind      String
  result    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("sync_receipts")
}
